# ─────────────────────────────────────────────────────────────────────────────
# URBAN TWIN — copy to .env:   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── MODULE SWITCHES ──────────────────────────────────────────────────────────
# Every module ships a working MOCK. Flip YOUR OWN flag to true only when your
# tests pass. Nobody else's demo is affected by your flag.
#   M1 → USE_REAL_DEFECTS      M2 → USE_REAL_TRAFFIC / USE_REAL_WHATIF / USE_REAL_RECOMMEND
#   M3 → USE_REAL_PEDESTRIAN / USE_REAL_FUSION / USE_REAL_RISK
#   M4 → USE_REAL_INCIDENTS
USE_REAL_DEFECTS=false
USE_REAL_PEDESTRIAN=false
USE_REAL_INCIDENTS=false
USE_REAL_TRAFFIC=false
USE_REAL_FUSION=false
USE_REAL_WHATIF=false
# AI intelligence layer (contracts v1.1.0 amendment)
USE_REAL_RISK=false
USE_REAL_RECOMMEND=false

# ── INFRASTRUCTURE ───────────────────────────────────────────────────────────
POSTGRES_USER=urbantwin
POSTGRES_PASSWORD=urbantwin
POSTGRES_DB=urbantwin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# async driver for the app, sync driver is derived automatically for alembic
DATABASE_URL=postgresql+asyncpg://urbantwin:urbantwin@localhost:5432/urbantwin

REDIS_URL=redis://localhost:6379/0
# host-side port for the redis container. Change this (and REDIS_URL) if you
# already run redis locally — `brew services list` will tell you.
REDIS_PORT=6379

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_CLIENT_PREFIX=urban-twin

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
# exact-match allowlist for browsers on localhost; a phone on the same wifi
# also gets through CORS_ORIGIN_REGEX (config.py) so http://<lan-ip>:5173/74/75
# works without editing this file
# One app, one port: 5173 is the only vite origin now. A phone on the same
# wifi also gets through CORS_ORIGIN_REGEX (config.py), so http://<lan-ip>:5173
# works without editing this file. In production the UI is served BY the api
# (same origin), so CORS is not involved at all.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Where the built frontend lives, for the one-container deployment. Leave this
# unset in development — vite owns the UI on :5173, and pointing the api at a
# stale `apps/web/dist` is a confusing way to lose an afternoon. The container
# image needs no value: the build lands at /app/web and is found automatically.
# WEB_DIST=apps/web/dist

# Host port the production stack publishes (docker-compose.prod.yml). Railway,
# Render and Fly all inject their own PORT — leave it unset there.
# PORT=8000

# ── REPLAY / SIMULATION ──────────────────────────────────────────────────────
REPLAY_SPEED=60          # virtual clock multiplier (60x = 1 min per real second)
REPLAY_BUSES=6
REPLAY_LOOP=true
REPLAY_TICK_SECONDS=1.0  # real seconds between simulation ticks

# ── PERCEPTION (real impls read these; mocks ignore them) ────────────────────
DEFECT_MODEL_PATH=models/defects-yolov8n.pt
DEFECT_CONF_THRESHOLD=0.45
PEDESTRIAN_MODEL_PATH=models/pedestrian-yolov8n.pt
PEDESTRIAN_CONF_THRESHOLD=0.50
INCIDENT_MODEL_PATH=models/incidents-yolov8n.pt
ANPR_LANG=en
PLATE_HASH_SALT=change-me-before-demo   # DPDP Act 2023: plates are salted-hashed, never stored raw

# ── ANALYTICS ────────────────────────────────────────────────────────────────
TRAFFIC_WINDOW_MINUTES=15
FUSION_EPS_METERS=25
FUSION_MIN_SAMPLES=2
WHATIF_MAX_CLOSED_ROADS=5

# ── FRONTEND (vite reads VITE_* only, at BUILD time) ─────────────────────────
# Leave VITE_API_BASE_URL / VITE_WS_URL commented out. The app then talks to
# `${location.protocol}//${location.hostname}:${VITE_API_PORT}` — which
# resolves correctly whether you open http://localhost:5173 on your laptop or
# http://<your-lan-ip>:5173 from a phone on the same wifi. A hardcoded
# "localhost" here would silently break the phone case, because "localhost" on
# the phone means the phone.
#
# Set these two ONLY when the frontend is deployed somewhere the API is not —
# a Vercel build talking to a Railway API, say. In the one-container
# deployment they must stay unset: same origin, no configuration.
# VITE_API_BASE_URL=https://urban-twin-api.up.railway.app
# VITE_WS_URL=wss://urban-twin-api.up.railway.app/ws/live
VITE_API_PORT=8000
VITE_MAP_CENTER_LAT=13.0827
VITE_MAP_CENTER_LON=80.2707

# The field app is a route of the same origin (/field) — override only if you
# are hosting it separately, which nothing in this repo does.
# VITE_FIELD_APP_URL=https://twin.example.gov.in/field
